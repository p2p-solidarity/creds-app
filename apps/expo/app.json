{
  "expo": {
    "name": "Solid(ar)ity",
    "slug": "solidarity",
    "owner": "kidney",
    "icon": "./assets/icon.png",
    "scheme": [
      "solidarity",
      "airmeishi",
      "openid-credential-offer"
    ],
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "kidneyweakx.airmeishi",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:solidarity.gg",
        "applinks:app.solidarity.gg",
        "applinks:creds.id",
        "webcredentials:creds.id"
      ],
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.$(CFBundleIdentifier)"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.$(CFBundleIdentifier)"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments",
          "CloudKit"
        ],
        "com.apple.developer.nfc.readersession.formats": [
          "TAG"
        ],
        "com.apple.developer.pass-type-identifiers": [
          "$(TeamIdentifierPrefix)pass.kidneyweakx.airmeishi"
        ],
        "aps-environment": "production"
      },
      "infoPlist": {
        "CFBundleDisplayName": "creds.id",
        "NSCameraUsageDescription": "creds.id uses the camera to scan QR codes and passport MRZ.",
        "NSContactsUsageDescription": "creds.id can save business card information to your Contacts.",
        "NFCReaderUsageDescription": "creds.id reads your passport's NFC chip to verify identity.",
        "NSFaceIDUsageDescription": "creds.id uses Face ID to protect identity keys and authorize sensitive actions.",
        "NSPhotoLibraryUsageDescription": "creds.id saves QR codes and business card images to your Photo Library.",
        "UIApplicationSupportsIndirectInputEvents": true,
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "538MCM44UX"
    },
    "android": {
      "package": "gg.solidarity.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#010414"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.NFC",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "solidarity.gg"
            },
            {
              "scheme": "https",
              "host": "app.solidarity.gg"
            },
            {
              "scheme": "https",
              "host": "creds.id"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "autoVerify": true
        }
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://creds.id"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9F2",
          "dark": {
            "backgroundColor": "#060417"
          },
          "android": {
            "image": "./assets/splash-android-transparent.png",
            "backgroundColor": "#FBF9F2",
            "dark": {
              "backgroundColor": "#060417"
            }
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "useFrameworks": "static",
            "enableSceneSupport": true
          },
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "useLegacyPackaging": true
          }
        }
      ],
      "./plugins/withXcodeCloudScripts.js",
      "./plugins/withPrecompiledVisionCameraResizerMetal.js",
      "./plugins/withExpoModulesJsiPatches.js",
      "./plugins/withSemaphoreBindingsPod.js",
      "./plugins/withRustXcframeworkSearchPath.js",
      "./plugins/withDisableClangExplicitModules.js",
      "./plugins/withIosDeploymentTarget.js",
      "./plugins/withNfcReader.js",
      "./plugins/withIosBuildNumber.js",
      "./plugins/withAndroidReleaseSigning.js",
      ["./plugins/withAndroidDisplayName.js", { "name": "creds.id" }],
      "expo-sqlite",
      "expo-asset",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "expo-iap",
      "expo-status-bar",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf",
            "./assets/fonts/DMSans-SemiBold.ttf",
            "./assets/fonts/DMSans-Bold.ttf"
          ]
        }
      ]
    ],
    "runtimeVersion": "2.0.0",
    "updates": {
      "enabled": false
    },
    "extra": {
      "router": {
        "origin": "https://creds.id"
      },
      "eas": {
        "projectId": "425c3486-6541-4fad-a5d5-182bb340c7b0"
      }
    }
  }
}
