{
  "name": "@solidarity/expo",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "./scripts/normalize-ios-scheme.sh && expo run:ios --scheme solidarity",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "setup:android": "./scripts/setup-android-signing.sh",
    "setup:ios": "./scripts/setup-ios-signing.sh",
    "build:android:local": "./scripts/build-android-local.sh",
    "ios:prebuild:local": "./scripts/prebuild-ios-local.sh",
    "build:ios:local": "./scripts/build-ios-local.sh",
    "submit:android": "./scripts/android-submit.sh",
    "gcp:bootstrap": "./scripts/gcp-bootstrap.sh",
    "gcp:rotate-key": "./scripts/gcp-rotate-key.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:parity",
    "test:unit": "SKIP_INTEGRATION=1 bun test --preload ./test-setup.ts --max-concurrency=1 __tests__/unit",
    "test:parity": "bun test --preload ./test-setup.ts --max-concurrency=1 __tests__/parity",
    "pear:pack": "node scripts/pack-pear-worklet.mjs"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-google-signin/google-signin": "^16.2.0",
    "@scure/base": "^2.4.0",
    "@shopify/flash-list": "2.3.2",
    "@solidarity/nitro-attest": "workspace:*",
    "@solidarity/nitro-keystone": "workspace:*",
    "@solidarity/shared": "workspace:*",
    "b4a": "^1.9.0",
    "expo": "^58.0.21",
    "expo-asset": "~58.0.19",
    "expo-auth-session": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-contacts": "~58.0.10",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-iap": "^5.8.3",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "fflate": "^0.8.3",
    "hyperswarm": "^4.17.2",
    "i18next": "^26.5.11",
    "mrz": "5.0.2",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-bare-kit": "^0.15.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^2.1.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-qrcode-svg": "^6.3.48",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-vision-camera": "^5.2.4",
    "react-native-vision-camera-resizer": "^5.2.4",
    "react-native-vision-camera-worklets": "^5.2.4",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/config-plugins": "~58.0.11",
    "@types/b4a": "^1.9.0",
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "@types/streamx": "^2.9.5",
    "autoprefixer": "^10.6.2",
    "eas-cli": "^27.2.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19"
  },
  "react-native": {
    "supportedPlatforms": [
      "ios",
      "android"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-get-random-values"
      ]
    }
  }
}
