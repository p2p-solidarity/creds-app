{
  "name": "solidarity-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Solidarity (AirMeishi) — SwiftUI legacy + Expo/RN target + Nitro modules. See docs/migration/00-MIGRATION_PLAN.md",
  "workspaces": [
    "apps/*",
    "packages/*",
    "nitro-modules/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "cd apps/expo && bun run typecheck",
    "test": "bun run test:unit && bun run test:parity",
    "test:unit": "cd apps/expo && SKIP_INTEGRATION=1 bun test --preload ./test-setup.ts --max-concurrency=1 __tests__/unit",
    "test:parity": "cd apps/expo && bun test --preload ./test-setup.ts --max-concurrency=1 __tests__/parity",
    "expo:ios": "cd apps/expo && bun run ios",
    "expo:android": "cd apps/expo && bun run android",
    "expo:start": "cd apps/expo && bun run start",
    "expo:prebuild:ios": "cd apps/expo && bunx expo prebuild --platform ios",
    "expo:prebuild:android": "cd apps/expo && bunx expo prebuild --platform android",
    "build:ios:local": "cd apps/expo && bun run build:ios:local"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "expo": "^58.0.21",
    "hyperswarm": "^4.17.2",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "overrides": {
    "lightningcss": "1.32.0"
  }
}
